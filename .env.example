# Copy this file to .env and fill in real values. Never commit .env.

# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# From the Anthropic console (workspace API keys). Never commit it.
ANTHROPIC_API_KEY=

# Your Telegram numeric user id(s), comma separated.
# Leave empty on first run: message the bot and copy your id from the logs.
ALLOWED_USER_IDS=

TZ=Europe/Stockholm

# When the daily /myday message is sent (24-hour clock, in the timezone above).
MYDAY_TIME=07:00

# Google Calendar (read-only). See docs/google-setup.md.
# Where the one-time sign-in saved your token (inside the project folder).
GOOGLE_TOKEN_FILE=data/token.json
# Calendars shown in /myday, comma separated. "primary" is your main calendar.
CALENDAR_IDS=primary
# Calendars from this list are shown as "Busy" with no titles (use for office calendars).
CALENDAR_PRIVATE_IDS=

# Where /myday gets the weather (Lab 3, see docs/mcp.md):
#   direct = call Open-Meteo from the bot (default)
#   mcp    = ask our own MCP server; falls back to direct if MCP breaks
WEATHER_SOURCE=direct
